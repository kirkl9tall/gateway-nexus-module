{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommitsDisabled",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on Monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "labels": ["security", "priority-high"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "matchDepTypes": ["devDependencies"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchPackagePatterns": ["cryptography", "fernet", "authlib", "requests", "urllib3"],
      "labels": ["security", "review-required"],
      "automerge": false
    },
    {
      "matchUpdateTypes": ["major"],
      "labels": ["breaking", "review-required"],
      "automerge": false
    }
  ]
}
