# Secrets — DO NOT commit this file to git.
# Copy to config/secrets.env and set permissions: chmod 600 config/secrets.env
#
# Naming: {TARGET}_SFTP_PASS, {TARGET}_SFTP_USER, etc.

# Tomedo SFTP (example)
# TOMEDO_SFTP_HOST=192.168.2.215
# TOMEDO_SFTP_USER=your_user
# TOMEDO_SFTP_PASS=your_password

# Web UI (alternative to first-run wizard)
# GATEWAY_WEBUI_PASSWORD=change-me-min-12-chars

# Flask session secret (production)
# GATEWAY_WEBUI_SECRET=generate-a-long-random-string
