#!/bin/bash
# postinst script for jerumednexus-gateway
set -e

INSTALL_DIR="/opt/jerumednexus"
GATEWAY_USER="jerumednexus"

case "$1" in
    configure)
        # Create system user
        if ! getent passwd "$GATEWAY_USER" >/dev/null; then
            adduser --system --home "$INSTALL_DIR" --shell /usr/sbin/nologin \
                    --group --disabled-password "$GATEWAY_USER"
        fi
        usermod -aG dialout "$GATEWAY_USER" || true

        # Provision venv + install python deps
        if [ ! -d "$INSTALL_DIR/.venv" ]; then
            sudo -u "$GATEWAY_USER" python3 -m venv "$INSTALL_DIR/.venv"
        fi
        sudo -u "$GATEWAY_USER" "$INSTALL_DIR/.venv/bin/pip" install --upgrade pip --quiet
        sudo -u "$GATEWAY_USER" "$INSTALL_DIR/.venv/bin/pip" install -r "$INSTALL_DIR/requirements.txt" --quiet

        # Create directories
        mkdir -p /var/log/jerumednexus-gateway /var/lib/jerumednexus-gateway
        chown -R "$GATEWAY_USER:$GATEWAY_USER" \
                "$INSTALL_DIR" /var/log/jerumednexus-gateway /var/lib/jerumednexus-gateway

        # First-run config seeding
        if [ ! -f "$INSTALL_DIR/config/gateway.yaml" ] \
           && [ -f "$INSTALL_DIR/config/gateway.yaml.example" ]; then
            cp "$INSTALL_DIR/config/gateway.yaml.example" \
               "$INSTALL_DIR/config/gateway.yaml"
            chown "$GATEWAY_USER:$GATEWAY_USER" "$INSTALL_DIR/config/gateway.yaml"
            chmod 640 "$INSTALL_DIR/config/gateway.yaml"
        fi

        # Reload systemd + udev
        systemctl daemon-reload || true
        systemctl enable jerumednexus-gateway.service jerumednexus-webui.service || true
        udevadm control --reload-rules && udevadm trigger || true

        # UFW
        if command -v ufw >/dev/null 2>&1; then
            ufw allow 8080/tcp comment "JerumedNexus Web UI" || true
            ufw allow 5003/tcp comment "JerumedNexus HTTP ingestion" || true
        fi

        # Start webui immediately -- gateway needs config, so leave to admin
        systemctl start jerumednexus-webui.service || true

        echo ""
        echo "jerumednexus-gateway installed."
        echo "  1. Open http://$(hostname -I | awk '{print $1}'):8080 to set admin password"
        echo "  2. Edit $INSTALL_DIR/config/gateway.yaml"
        echo "  3. sudo systemctl start jerumednexus-gateway"
        echo ""
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
esac

exit 0
