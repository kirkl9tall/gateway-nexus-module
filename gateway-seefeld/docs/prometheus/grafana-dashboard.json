{
  "annotations": {"list": []},
  "editable": true,
  "gnetId": null,
  "graphTooltip": 1,
  "id": null,
  "iteration": 1,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Service up",
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0},
      "targets": [{"expr": "jerumednexus_up", "legendFormat": "up"}],
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "text": "DOWN"}, "1": {"color": "green", "text": "UP"}}, "type": "value"}]}}
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0},
      "targets": [{"expr": "jerumednexus_uptime_seconds"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "stat",
      "title": "Results today",
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0},
      "targets": [{"expr": "jerumednexus_results_today"}]
    },
    {
      "type": "stat",
      "title": "Errors today",
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0},
      "targets": [{"expr": "jerumednexus_errors_today"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 5}, {"color": "red", "value": 20}]}}}
    },
    {
      "type": "gauge",
      "title": "Queue depth",
      "gridPos": {"h": 4, "w": 8, "x": 16, "y": 0},
      "targets": [{"expr": "jerumednexus_queue_size / jerumednexus_queue_maxsize"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.7}, {"color": "red", "value": 0.9}]}}}
    },
    {
      "type": "timeseries",
      "title": "Results per second (rate)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [
        {"expr": "rate(jerumednexus_results_total[5m])", "legendFormat": "OK"},
        {"expr": "rate(jerumednexus_errors_today[5m])", "legendFormat": "errors"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Device staleness (seconds since last frame)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "time() - jerumednexus_device_last_seen_seconds", "legendFormat": "{{device}}"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "type": "table",
      "title": "Circuit breakers",
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12},
      "targets": [{"expr": "jerumednexus_target_breaker_state", "format": "table", "instant": true}]
    },
    {
      "type": "table",
      "title": "Enabled targets",
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12},
      "targets": [{"expr": "jerumednexus_target_enabled == 1", "format": "table", "instant": true}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["jerumednexus", "hl7"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "JerumedNexus Gateway",
  "uid": "jerumednexus-gateway",
  "version": 1
}
